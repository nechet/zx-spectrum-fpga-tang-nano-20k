;
; WS2812 driver for the RP2040-Zero's onboard RGB LED (GP16), used purely as a
; status light: this converter is a USB host, so it never enumerates as a
; device and otherwise gives no sign of whether it is alive, whether the
; keyboard was found, or whether keys are arriving.
;
; 800 kHz: a bit is 1.25 us, split 0.4/0.85 for a zero and 0.8/0.45 for a one.
;
.program ws2812
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
  out    x, 1        side 0 [T3 - 1]
  jmp    !x do_zero  side 1 [T1 - 1]
do_one:
  jmp    bitloop     side 1 [T2 - 1]
do_zero:
  nop                side 0 [T2 - 1]
.wrap

% c-sdk {

  void ws2812_program_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = ws2812_program_get_default_config(offset);

    pio_gpio_init(pio, STATUSLED);
    pio_sm_set_consecutive_pindirs(pio, sm, STATUSLED, 1, true);

    sm_config_set_sideset_pins(&c, STATUSLED);
    sm_config_set_out_shift(&c, false, true, 24);     // MSB first, 24 bits
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    float div = (float)clock_get_hz(clk_sys) /
                (800000.0f * (ws2812_T1 + ws2812_T2 + ws2812_T3));
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
  }

%}
